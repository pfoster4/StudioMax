if SHIELD_STUDIOMAX_LEFT

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "StudioMax"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
  default 1

config BT_MAX_CONN
  default 6

config BT_MAX_PAIRED
  default 6

endif

if SHIELD_STUDIOMAX_LEFT || SHIELD_STUDIOMAX_RIGHT

config ZMK_SPLIT
    default y

endif

# SHIELD_STUDIOMAX_LEFT uses NFC pins (P0.09/P0.10) on nRF52840 as GPIO
if SHIELD_STUDIOMAX_LEFT
config NFCT_PINS_AS_GPIOS
    default y
endif

# SHIELD_STUDIOMAX_RIGHT uses NFC pins (P0.09/P0.10) on nRF52840 as GPIO
if SHIELD_STUDIOMAX_RIGHT
config NFCT_PINS_AS_GPIOS
    default y
endif

# --- Pinctrl Kconfig for part "left" ---
if BOARD_SEEEDUINO_XIAO_BLE && SHIELD_STUDIOMAX_LEFT

config SPI
    default y

config WS2812_STRIP
    default y

endif

# --- Pinctrl Kconfig for part "right" ---
if BOARD_SEEEDUINO_XIAO_BLE && SHIELD_STUDIOMAX_RIGHT

config SPI
    default y

config WS2812_STRIP
    default y

endif
