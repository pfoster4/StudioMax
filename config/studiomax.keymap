            #binding-cells = <0>;
            bindings = <&macro_press>,<&kp LEFT_WIN>,<&macro_tap>,<&kp E>,<&macro_release>,<&kp LEFT_WIN>;

            label = "NEWWINDOW_MACRO";
            wait-ms = <50>;
            tap-ms = <50>;
        };

